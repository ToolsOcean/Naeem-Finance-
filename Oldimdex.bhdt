          <div class="grid grid-cols-2 gap-2 mt-2 pt-2 border-t border-slate-200 text-[11px]"><div class="flex justify-between text-[10px]">Interest: <span id="interestResult" class="font-bold text-slate-700 ml-1">₹15,231</span></div><div class="flex justify-between text-[10px]">Total: <span id="totalResult" class="font-bold text-slate-700 ml-1">₹1,15,231</span></div></div>
