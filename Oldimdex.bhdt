  <!-- Script: Complete 102 Offers Database & Accurate Brand Matching Engine -->
  <script>
    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

    // Slider Engine
    let currentSlide = 0;
    const totalSlides = 4;
    const track = document.getElementById('sliderTrack');
    const dots = document.querySelectorAll('.slide-dot');
    function goToSlide(idx) {
      currentSlide = idx;
      track.style.transform = `translateX(-${idx * 100}%)`;
      dots.forEach((dot, i) => { dot.className = i === idx ? 'w-4 h-1 rounded-full bg-white slide-dot transition-all' : 'w-1 h-1 rounded-full bg-white/40 slide-dot transition-all'; });
    }
    setInterval(() => { currentSlide = (currentSlide + 1) % totalSlides; goToSlide(currentSlide); }, 4500);

    // EMI Calculator
    function calculateEMI() {
      const P = parseFloat(document.getElementById('loanAmount').value); 
      const N = parseFloat(document.getElementById('loanTenure').value); 
      const annualR = parseFloat(document.getElementById('loanRate').value); 
      const R = (annualR / 12) / 100;
      document.getElementById('amtLabel').innerText = '₹ ' + P.toLocaleString('en-IN'); 
      document.getElementById('tenureLabel').innerText = N + ' Months'; 
      document.getElementById('rateLabel').innerText = annualR.toFixed(1) + ' %';
      const emi = (P * R * Math.pow(1 + R, N)) / (Math.pow(1 + R, N) - 1); 
      const totalPayable = emi * N; 
      const totalInterest = totalPayable - P; 
      const minIncome = Math.round(emi / 0.40);
      document.getElementById('emiResult').innerText = '₹ ' + Math.round(emi).toLocaleString('en-IN'); 
      document.getElementById('interestResult').innerText = '₹ ' + Math.round(totalInterest).toLocaleString('en-IN'); 
      document.getElementById('totalResult').innerText = '₹ ' + Math.round(totalPayable).toLocaleString('en-IN'); 
      document.getElementById('incomeNeeded').innerText = '₹' + minIncome.toLocaleString('en-IN') + '/mo';
    }

    // Toggle Details Accordion Function
    function toggleDetails(id) {
      const el = document.getElementById(`details-${id}`);
      const btn = document.getElementById(`btn-${id}`);
      if (el.classList.contains('hidden')) {
        el.classList.remove('hidden');
        btn.innerText = 'Hide Details ▲';
      } else {
        el.classList.add('hidden');
        btn.innerText = 'View Details & Interest Rate ▼';
      }
    }

    // Helper for pure in-code SVG vector logos (Option 3 - 100% Fail-Proof)
    function getSvgBadge(type) {
      if (type === 'jio') {
        return `<svg viewBox="0 0 100 100" class="w-full h-full"><circle cx="50" cy="50" r="48" fill="#0A2885"/><text x="50" y="58" fill="#fff" font-size="28" font-weight="900" text-anchor="middle" font-family="sans-serif">Jio</text></svg>`;
      }
      if (type === 'ring') {
        return `<svg viewBox="0 0 100 100" class="w-full h-full"><rect width="100" height="100" rx="20" fill="#4338CA"/><circle cx="50" cy="50" r="32" fill="none" stroke="#38BDF8" stroke-width="12"/></svg>`;
      }
      if (type === 'fatakpay') {
        return `<svg viewBox="0 0 100 100" class="w-full h-full"><rect width="100" height="100" rx="20" fill="#0284C7"/><path d="M55 20 L25 55 L48 55 L42 80 L75 45 L52 45 Z" fill="#FACC15"/></svg>`;
      }
      if (type === 'unity') {
        return `<svg viewBox="0 0 100 100" class="w-full h-full"><rect width="100" height="100" rx="20" fill="#0369A1"/><circle cx="50" cy="50" r="28" fill="none" stroke="#fff" stroke-width="8"/><text x="50" y="58" fill="#fff" font-size="24" font-weight="900" text-anchor="middle">U</text></svg>`;
      }
      if (type === 'incred') {
        return `<svg viewBox="0 0 100 100" class="w-full h-full"><rect width="100" height="100" rx="20" fill="#EA580C"/><text x="50" y="60" fill="#fff" font-size="26" font-weight="900" text-anchor="middle">InCred</text></svg>`;
      }
      if (type === 'rupayfuel') {
        return `<svg viewBox="0 0 100 100" class="w-full h-full"><rect width="100" height="100" rx="20" fill="#C2410C"/><path d="M40 30 C40 30 35 45 40 55 C45 65 55 65 55 55 C55 45 65 40 65 30 C55 25 45 25 40 30 Z" fill="#FDBA74"/><text x="50" y="82" fill="#fff" font-size="14" font-weight="900" text-anchor="middle">FUEL</text></svg>`;
      }
      if (type === 'quickcash') {
        return `<svg viewBox="0 0 100 100" class="w-full h-full"><rect width="100" height="100" rx="20" fill="#047857"/><text x="50" y="60" fill="#fff" font-size="34" font-weight="900" text-anchor="middle">₹</text></svg>`;
      }
      return null;
    }

    // Exact Brand Palette Matching (Zero Pitch-Black Generic Buttons)
    function getBrandPalette(name) {
      const n = name.toLowerCase();
      
      if (n.includes('axis')) {
        return { cardBg: 'bg-[#FFF5F8]', border: 'border-2 border-[#97144D]', btnBg: 'bg-[#97144D] hover:bg-[#7D0E3E]', btnText: 'text-white', badgeBg: 'bg-[#97144D] text-white', accentText: 'text-[#97144D]' };
      }
      if (n.includes('kotak')) {
        return { cardBg: 'bg-[#FFF5F5]', border: 'border-2 border-[#ED1B24]', btnBg: 'bg-[#ED1B24] hover:bg-[#C9121A]', btnText: 'text-white', badgeBg: 'bg-[#ED1B24] text-white', accentText: 'text-[#ED1B24]' };
      }
      if (n.includes('hdfc')) {
        return { cardBg: 'bg-[#F2F7FC]', border: 'border-2 border-[#004C8F]', btnBg: 'bg-[#004C8F] hover:bg-[#003766]', btnText: 'text-white', badgeBg: 'bg-[#004C8F] text-white', accentText: 'text-[#004C8F]' };
      }
      if (n.includes('sbi')) {
        return { cardBg: 'bg-[#F0F7FF]', border: 'border-2 border-[#004A97]', btnBg: 'bg-[#004A97] hover:bg-[#003875]', btnText: 'text-white', badgeBg: 'bg-[#004A97] text-white', accentText: 'text-[#004A97]' };
      }
      if (n.includes('poonawalla')) {
        return { cardBg: 'bg-[#FCF2F7]', border: 'border-2 border-[#A00055]', btnBg: 'bg-[#A00055] hover:bg-[#850046]', btnText: 'text-white', badgeBg: 'bg-[#A00055] text-white', accentText: 'text-[#A00055]' };
      }
      if (n.includes('tata')) {
        return { cardBg: 'bg-[#F8F4FD]', border: 'border-2 border-[#60269E]', btnBg: 'bg-[#60269E] hover:bg-[#4E1E82]', btnText: 'text-white', badgeBg: 'bg-[#60269E] text-white', accentText: 'text-[#60269E]' };
      }
      if (n.includes('branch')) {
        return { cardBg: 'bg-[#F0F5FF]', border: 'border-2 border-[#0B2545]', btnBg: 'bg-[#0B2545] hover:bg-[#081C33]', btnText: 'text-white', badgeBg: 'bg-[#0B2545] text-white', accentText: 'text-[#0B2545]' };
      }
      if (n.includes('mpokket')) {
        return { cardBg: 'bg-[#F0F9FF]', border: 'border-2 border-[#0284C7]', btnBg: 'bg-[#0284C7] hover:bg-[#0369A1]', btnText: 'text-white', badgeBg: 'bg-[#0284C7] text-white', accentText: 'text-[#0284C7]' };
      }
      if (n.includes('true balance')) {
        return { cardBg: 'bg-[#FFF5F2]', border: 'border-2 border-[#EA580C]', btnBg: 'bg-[#EA580C] hover:bg-[#C2410C]', btnText: 'text-white', badgeBg: 'bg-[#EA580C] text-white', accentText: 'text-[#EA580C]' };
      }
      if (n.includes('paapapay')) {
        return { cardBg: 'bg-[#FAF8F5]', border: 'border-2 border-[#451A03]', btnBg: 'bg-[#451A03] hover:bg-[#290E02]', btnText: 'text-white', badgeBg: 'bg-[#451A03] text-white', accentText: 'text-[#451A03]' };
      }
      if (n.includes('zapcash')) {
        return { cardBg: 'bg-[#F0FDF4]', border: 'border-2 border-[#16A34A]', btnBg: 'bg-[#16A34A] hover:bg-[#15803D]', btnText: 'text-white', badgeBg: 'bg-[#16A34A] text-white', accentText: 'text-[#16A34A]' };
      }
      if (n.includes('myflot')) {
        return { cardBg: 'bg-[#FAF5FF]', border: 'border-2 border-[#7E22CE]', btnBg: 'bg-[#7E22CE] hover:bg-[#6B21A8]', btnText: 'text-white', badgeBg: 'bg-[#7E22CE] text-white', accentText: 'text-[#7E22CE]' };
      }
      if (n.includes('roarbank')) {
        return { cardBg: 'bg-[#F8FAFC]', border: 'border-2 border-[#1E293B]', btnBg: 'bg-[#1E293B] hover:bg-[#0F172A]', btnText: 'text-white', badgeBg: 'bg-[#1E293B] text-white', accentText: 'text-[#1E293B]' };
      }
      if (n.includes('pop upi') || n.includes('popclub')) {
        return { cardBg: 'bg-[#FEF2F2]', border: 'border-2 border-[#DC2626]', btnBg: 'bg-[#DC2626] hover:bg-[#B91C1C]', btnText: 'text-white', badgeBg: 'bg-[#DC2626] text-white', accentText: 'text-[#DC2626]' };
      }
      if (n.includes('kiwi')) {
        return { cardBg: 'bg-[#F0FDF4]', border: 'border-2 border-[#059669]', btnBg: 'bg-[#059669] hover:bg-[#047857]', btnText: 'text-white', badgeBg: 'bg-[#059669] text-white', accentText: 'text-[#059669]' };
      }
      if (n.includes('scapia')) {
        return { cardBg: 'bg-[#FFF1F2]', border: 'border-2 border-[#E11D48]', btnBg: 'bg-[#E11D48] hover:bg-[#BE123C]', btnText: 'text-white', badgeBg: 'bg-[#E11D48] text-white', accentText: 'text-[#E11D48]' };
      }
      if (n.includes('bobcard') || n.includes('fuel & utility') || n.includes('valueback')) {
