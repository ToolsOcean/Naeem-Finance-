<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Naeem Finance — Compare & Apply Financial Products</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAFC; color: #0F172A; scroll-behavior: smooth; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .app-card { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 16px; position: relative; overflow: hidden; }
    .app-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.12); }
    .app-card:active { transform: scale(0.98); }

    .modal-backdrop { background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(6px); }
    .slide-dot { transition: all 0.3s ease; }

    @keyframes floating { 0% { transform: translateY(0px) rotate(12deg); } 50% { transform: translateY(-5px) rotate(14deg); } 100% { transform: translateY(0px) rotate(12deg); } }
    .floating-card { animation: floating 3s ease-in-out infinite; }
    input[type=range] { accent-color: #2563EB; }
  </style>
</head>
<body class="antialiased min-h-screen flex flex-col justify-between">

  <!-- 1. Header -->
  <header class="bg-white sticky top-0 z-40 border-b border-slate-200 shadow-sm">
    <div class="max-w-4xl mx-auto px-4 py-2.5 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full overflow-hidden border border-slate-200 shrink-0 bg-slate-100 p-0.5 shadow-inner">
          <img 
            src="https://imgh.in/host/107qpx" 
            alt="Naeem Finance" 
            class="w-full h-full object-cover rounded-full"
            onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Naeem+Finance&background=2563EB&color=fff&size=100&bold=true';"
          >
        </div>
        <div>
          <span class="text-xs font-black tracking-tight text-slate-900 block leading-tight">Naeem<span class="text-blue-600">Finance</span></span>
          <span class="text-[9px] text-slate-400 font-bold uppercase tracking-widest">Financial Affiliate Hub</span>
        </div>
      </div>
      
      <a href="tel:+917070664940" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200/80 hover:bg-blue-100 transition shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Contact Expert</span>
      </a>
    </div>
  </header>

  <div class="max-w-4xl mx-auto px-4 w-full">

    <!-- 2. GroMo Style 3D Banners -->
    <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 shadow-sm relative">
      <div id="sliderTrack" class="flex transition-transform duration-500 ease-out">
        
        <!-- Slide 1: Kotak 811 -->
        <div class="w-full shrink-0 flex items-center justify-between p-4 sm:p-5 gap-3 bg-gradient-to-br from-[#09111e] via-[#0D1E38] to-[#152e54] text-white">
          <div class="flex-1">
            <span class="text-[9px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 px-2 py-0.5 rounded-full">⚡ Instant Digital A/c</span>
            <h2 class="text-base sm:text-lg font-black mt-1.5 leading-tight">Kotak 811 Classic Savings</h2>
            <div class="text-[10px] text-slate-300 mt-1.5 space-y-0.5 leading-relaxed">
              <div class="flex items-center gap-1">✓ ₹0 Balance Maintenance</div>
              <div class="flex items-center gap-1">✓ Free Platinum Virtual Debit Card</div>
              <div class="flex items-center gap-1">✓ Flat 5% Cashback Rewards</div>
            </div>
            <a href="https://sales.gromo.in/kt/kXI6nqhtkS" target="_blank" class="mt-3 inline-block bg-red-600 hover:bg-red-500 text-white font-bold text-[10px] px-3.5 py-1.5 rounded-lg shrink-0 shadow active:scale-95 transition">
              Open Zero Balance A/c →
            </a>
          </div>
          <div class="w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center relative shrink-0">
            <div class="absolute w-20 h-20 bg-blue-500/30 blur-2xl rounded-full"></div>
            <div class="w-16 h-24 bg-[#020617] rounded-xl border-2 border-[#475569] shadow-inner p-1 transform -rotate-3 overflow-hidden">
              <div class="w-10 h-1 bg-[#334155] rounded-full mx-auto mb-1"></div>
              <div class="bg-[#1e293b] rounded-lg h-full p-1.5">
                <div class="w-full h-4 bg-emerald-600 rounded-md mb-1.5"></div>
                <div class="w-2/3 h-1.5 bg-[#475569] rounded mt-1.5"></div>
              </div>
            </div>
            <div class="absolute right-0 bottom-4 w-20 h-12 bg-gradient-to-br from-red-600 to-red-800 rounded-lg border border-white/30 transform rotate(12deg) shadow-2xl p-1.5 flex flex-col justify-between floating-card">
              <div class="flex justify-between items-center"><div class="w-3 h-2.5 bg-yellow-400 rounded-sm"></div><span class="text-[6px] font-black text-white">VISA</span></div>
              <div class="text-[6px] text-white/80 font-mono tracking-wider">•••• 8110</div>
            </div>
          </div>
        </div>

        <!-- Slide 2: Flipkart Axis Bank Card -->
        <div class="w-full shrink-0 flex items-center justify-between p-4 sm:p-5 gap-3 bg-gradient-to-br from-[#09111e] via-[#161F38] to-[#252354] text-white">
          <div class="flex-1">
            <span class="text-[9px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded-full">🔥 Top Cashback Card</span>
            <h2 class="text-base sm:text-lg font-black mt-1.5 leading-tight">Flipkart Axis Bank Credit Card</h2>
            <div class="text-[10px] text-slate-300 mt-1.5 space-y-0.5 leading-relaxed">
              <div class="flex items-center gap-1">✓ Flat 5% Unlimited Cashback (Flipkart)</div>
              <div class="flex items-center gap-1">✓ 4% Cashback on Swiggy & Uber</div>
              <div class="flex items-center gap-1">✓ ₹350 Welcome Activation Voucher</div>
            </div>
            <a href="https://sales.gromo.in/ac/kXI6nqhtkS" target="_blank" class="mt-3 inline-block bg-[#97144D] hover:opacity-90 text-white font-bold text-[10px] px-3.5 py-1.5 rounded-lg shrink-0 shadow active:scale-95 transition">
              Get Card Now →
            </a>
          </div>
          <div class="w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center relative shrink-0">
            <div class="absolute w-20 h-20 bg-blue-500/30 blur-2xl rounded-full"></div>
            <div class="w-16 h-24 bg-[#020617] rounded-xl border-2 border-[#475569] shadow-inner p-1 transform -rotate-3 overflow-hidden">
              <div class="w-10 h-1 bg-[#334155] rounded-full mx-auto mb-1"></div>
              <div class="bg-[#1e293b] rounded-lg h-full p-1.5">
                <div class="w-full h-4 bg-indigo-600 rounded-md mb-1.5"></div>
              </div>
            </div>
            <div class="absolute right-0 bottom-4 w-20 h-12 bg-slate-900 rounded-lg border-2 border-indigo-400 transform rotate(12deg) shadow-2xl p-1.5 flex flex-col justify-between floating-card">
              <div class="relative flex justify-between items-center"><div class="w-3 h-2.5 bg-yellow-400 rounded-sm"></div><span class="text-[6px] font-black text-white">AXIS</span></div>
              <div class="relative text-[6px] text-white/80 font-mono tracking-wider">•••• 4412</div>
            </div>
          </div>
        </div>

        <!-- Slide 3: Pocketly Loan -->
        <div class="w-full shrink-0 flex items-center justify-between p-4 sm:p-5 gap-3 bg-gradient-to-br from-[#0C121A] via-[#0F1E2A] to-[#122A3A] text-white">
          <div class="flex-1">
            <span class="text-[9px] font-black uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 px-2 py-0.5 rounded-full">🚀 Micro Cash Loan</span>
            <h2 class="text-base sm:text-lg font-black mt-1.5 leading-tight">Pocketly Instant Cash Loan</h2>
            <div class="text-[10px] text-slate-300 mt-1.5 space-y-0.5 leading-relaxed">
              <div class="flex items-center gap-1">✓ ₹500 to ₹10,000 Direct Disbursal</div>
              <div class="flex items-center gap-1">✓ No Past CIBIL Score Needed</div>
              <div class="flex items-center gap-1">✓ Referral Code: <span class="text-amber-300 font-bold">HTY9KF2Q</span></div>
            </div>
            <a href="https://pocketly.sng.link/D4bv7/8nx0/g23r?_dl=pocketly%3A%2F%2FReferAndEarnScreen&_ddl=pocketly%3A%2F%2FReferAndEarnScreen&_forward_params=2&code=HTY9KF2Q&name=Md%20Naeem%20Akhtar" target="_blank" class="mt-3 inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] px-3.5 py-1.5 rounded-lg shrink-0 shadow active:scale-95 transition">
              Get Instant Cash →
            </a>
          </div>
          <div class="w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center relative shrink-0">
            <div class="absolute w-20 h-20 bg-blue-500/30 blur-2xl rounded-full"></div>
            <div class="w-16 h-16 sm:w-20 sm:h-20 bg-[#1e293b] rounded-2xl border border-white/10 p-2 flex flex-col justify-between transform -rotate-6">
              <div class="flex justify-between items-center"><span class="text-xl">₹</span><span class="text-[8px] font-bold text-emerald-400">APPROVED</span></div>
              <div class="w-full h-1 bg-emerald-500 rounded"></div>
            </div>
            <div class="absolute w-8 h-8 rounded-full bg-emerald-500 flex items-center justify-center -top-2 -right-2 text-xl font-bold floating-card">⚡</div>
          </div>
        </div>

        <!-- Slide 4: Angel One Demat -->
        <div class="w-full shrink-0 flex items-center justify-between p-4 sm:p-5 gap-3 bg-gradient-to-br from-[#0C121A] via-[#131B2A] to-[#1E253A] text-white">
          <div class="flex-1">
            <span class="text-[9px] font-black uppercase tracking-wider bg-blue-500/20 text-blue-300 border border-blue-500/40 px-2 py-0.5 rounded-full">📈 Zero Brokerage</span>
            <h2 class="text-base sm:text-lg font-black mt-1.5 leading-tight">Angel One Super Demat A/c</h2>
            <div class="text-[10px] text-slate-300 mt-1.5 space-y-0.5 leading-relaxed">
              <div class="flex items-center gap-1">✓ ₹0 Account Opening Charges</div>
              <div class="flex items-center gap-1">✓ ₹0 Delivery Brokerage Lifetime</div>
              <div class="flex items-center gap-1">✓ Free AMC for 1st Year</div>
            </div>
            <a href="https://leads.goldenteam.in/?h=SHFjNEhEQWY0bEZrdCtwUGVOS21QZz09" target="_blank" class="mt-3 inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold text-[10px] px-3.5 py-1.5 rounded-lg shrink-0 shadow active:scale-95 transition">
              Open Free Demat →
            </a>
          </div>
          <div class="w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center relative shrink-0">
            <div class="absolute w-20 h-20 bg-blue-500/30 blur-2xl rounded-full"></div>
            <div class="w-16 h-16 sm:w-20 sm:h-20 bg-[#1e293b] rounded-2xl border border-white/10 p-2 flex flex-col transform rotate-6 relative overflow-hidden">
              <div class="text-[10px] font-bold">ANGEL</div>
              <div class="absolute bottom-1 left-2 w-16 h-8 flex gap-0.5 items-end justify-between">
                <div class="w-2 h-2 bg-red-500 rounded-sm"></div><div class="w-2 h-4 bg-emerald-500 rounded-sm"></div><div class="w-2 h-3 bg-emerald-500 rounded-sm"></div>
              </div>
            </div>
            <div class="absolute w-8 h-8 rounded-full bg-emerald-500 flex items-center justify-center -top-2 -right-2 text-xl font-bold floating-card">📈</div>
          </div>
        </div>

      </div>

      <div class="absolute bottom-2 left-1/2 transform -translate-x-1/2 flex justify-center gap-1.5">
        <button onclick="goToSlide(0)" class="w-4 h-1 rounded-full bg-white slide-dot transition-all"></button>
        <button onclick="goToSlide(1)" class="w-1 h-1 rounded-full bg-white/40 slide-dot transition-all"></button>
        <button onclick="goToSlide(2)" class="w-1 h-1 rounded-full bg-white/40 slide-dot transition-all"></button>
        <button onclick="goToSlide(3)" class="w-1 h-1 rounded-full bg-white/40 slide-dot transition-all"></button>
      </div>
    </div>

    <!-- 3. Categories -->
    <div class="mt-5">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Categories</h2>
        <span class="text-[10px] font-bold text-blue-600 bg-blue-50 border border-blue-100 px-2 py-0.5 rounded-md">102 Deals</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
        <button onclick="selectCategory('zerocibil')" class="bg-white rounded-xl p-3 border border-slate-200 shadow-sm flex items-center justify-between text-left cursor-pointer app-card group">
          <div class="relative z-10">
            <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition">Zero CIBIL Loan</h3>
            <span class="text-[10px] text-emerald-600 font-semibold block mt-0.5">First-Time Borrowers</span>
            <span class="text-[9px] bg-emerald-50 text-emerald-700 font-bold px-1.5 py-0.5 rounded mt-1.5 inline-block border border-emerald-100">12 Offers</span>
          </div>
          <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center text-lg shrink-0 relative z-10">⚡</div>
        </button>

        <button onclick="selectCategory('cards')" class="bg-white rounded-xl p-3 border border-slate-200 shadow-sm flex items-center justify-between text-left cursor-pointer app-card group">
          <div class="relative z-10">
            <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition">Credit Cards</h3>
            <span class="text-[10px] text-indigo-600 font-semibold block mt-0.5">Cashback & Rewards</span>
            <span class="text-[9px] bg-indigo-50 text-indigo-700 font-bold px-1.5 py-0.5 rounded mt-1.5 inline-block border border-indigo-100">32 Offers</span>
          </div>
          <div class="w-9 h-9 rounded-lg bg-indigo-50 flex items-center justify-center text-lg shrink-0 relative z-10">💳</div>
        </button>

        <button onclick="selectCategory('demat')" class="bg-white rounded-xl p-3 border border-slate-200 shadow-sm flex items-center justify-between text-left cursor-pointer app-card group">
          <div class="relative z-10">
            <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition">Demat & Wealth</h3>
            <span class="text-[10px] text-amber-600 font-semibold block mt-0.5">Stocks, FD & SIP</span>
            <span class="text-[9px] bg-amber-50 text-amber-700 font-bold px-1.5 py-0.5 rounded mt-1.5 inline-block border border-amber-100">20 Offers</span>
          </div>
          <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center text-lg shrink-0 relative z-10">📈</div>
        </button>

        <button onclick="selectCategory('loans')" class="bg-white rounded-xl p-3 border border-slate-200 shadow-sm flex items-center justify-between text-left cursor-pointer app-card group">
          <div class="relative z-10">
            <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition">Personal Loans</h3>
            <span class="text-[10px] text-blue-600 font-semibold block mt-0.5">Instant Disbursal</span>
            <span class="text-[9px] bg-blue-50 text-blue-700 font-bold px-1.5 py-0.5 rounded mt-1.5 inline-block border border-blue-100">26 Offers</span>
          </div>
          <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center text-lg shrink-0 relative z-10">💰</div>
        </button>

        <button onclick="selectCategory('savings')" class="bg-white rounded-xl p-3 border border-slate-200 shadow-sm flex items-center justify-between text-left cursor-pointer app-card group">
          <div class="relative z-10">
            <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition">Saving A/c</h3>
            <span class="text-[10px] text-purple-600 font-semibold block mt-0.5">Zero Balance Banking</span>
            <span class="text-[9px] bg-purple-50 text-purple-700 font-bold px-1.5 py-0.5 rounded mt-1.5 inline-block border border-purple-100">5 Offers</span>
          </div>
          <div class="w-9 h-9 rounded-lg bg-purple-50 flex items-center justify-center text-lg shrink-0 relative z-10">🏦</div>
        </button>

        <button onclick="selectCategory('secured')" class="bg-white rounded-xl p-3 border border-slate-200 shadow-sm flex items-center justify-between text-left cursor-pointer app-card group">
          <div class="relative z-10">
            <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition">Secured Card</h3>
            <span class="text-[10px] text-cyan-600 font-semibold block mt-0.5">Card Against FD</span>
            <span class="text-[9px] bg-cyan-50 text-cyan-700 font-bold px-1.5 py-0.5 rounded mt-1.5 inline-block border border-cyan-100">7 Offers</span>
          </div>
          <div class="w-9 h-9 rounded-lg bg-cyan-50 flex items-center justify-center text-lg shrink-0 relative z-10">🛡</div>
        </button>
      </div>
    </div>

    <!-- 4. Filter Tabs & Search Bar -->
    <div class="mt-6" id="offersSection">
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 border-b border-slate-200">
        <button id="tabZeroCibil" onclick="switchTab('zerocibil')" class="px-3 py-1.5 font-bold text-xs rounded-lg text-slate-600 bg-white border border-slate-200 shrink-0 transition">Zero CIBIL (12)</button>
        <button id="tabCards" onclick="switchTab('cards')" class="px-3 py-1.5 font-semibold text-xs rounded-lg text-slate-600 bg-white border border-slate-200 shrink-0 transition">Credit Cards (32)</button>
        <button id="tabDemat" onclick="switchTab('demat')" class="px-3 py-1.5 font-semibold text-xs rounded-lg text-slate-600 bg-white border border-slate-200 shrink-0 transition">Demat & Invest (20)</button>
        <button id="tabLoans" onclick="switchTab('loans')" class="px-3 py-1.5 font-semibold text-xs rounded-lg text-slate-600 bg-white border border-slate-200 shrink-0 transition">Loans (26)</button>
        <button id="tabSavings" onclick="switchTab('savings')" class="px-3 py-1.5 font-semibold text-xs rounded-lg text-slate-600 bg-white border border-slate-200 shrink-0 transition">Saving A/c (5)</button>
        <button id="tabSecured" onclick="switchTab('secured')" class="px-3 py-1.5 font-semibold text-xs rounded-lg text-slate-600 bg-white border border-slate-200 shrink-0 transition">Secured Cards (7)</button>
      </div>

      <div class="mt-3 relative">
        <input type="text" id="globalSearch" onkeyup="filterCurrentData()" placeholder="ब्रांड या बैंक खोजें (उदा. Pocketly, Branch, mPokket, Angel One, Flipkart Axis)..." class="w-full px-3.5 py-2 pl-9 rounded-xl bg-white border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600 text-xs shadow-sm transition">
        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
    </div>

    <!-- 5. Offers Grid Section -->
    <main class="mt-4 pb-4">
      <div class="flex items-center justify-between mb-3">
        <h2 id="sectionHeading" class="text-xs font-bold text-slate-800 uppercase tracking-wide">Zero CIBIL & First-Time Borrower Loans</h2>
        <span id="resultCount" class="text-[10px] font-bold text-blue-600 bg-blue-50 border border-blue-100 px-2 py-0.5 rounded-md">12 Offers</span>
      </div>

      <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <!-- Rendered by JS -->
      </div>

      <div id="noResults" class="hidden text-center py-10 bg-white rounded-xl border border-slate-200 my-4">
        <p class="text-xs text-slate-500 font-semibold">कोई ऑफर नहीं मिला। कृपया दूसरा बैंक या ऐप का नाम खोजें।</p>
      </div>
    </main>

    <!-- 6. Loan EMI Calculator -->
    <section class="mt-6 bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-sm">
      <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-slate-100">
        <div><span class="text-[9px] font-bold uppercase tracking-wider text-blue-600">Free Financial Tool</span><h2 class="text-xs sm:text-sm font-extrabold text-slate-900">EMI & Salary Eligibility Calculator</h2></div><span class="text-lg">🧮</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-center">
        <div class="space-y-3 text-xs">
          <div><div class="flex justify-between font-semibold mb-1"><span class="text-slate-500">Loan Amount:</span><span id="amtLabel" class="text-blue-700 font-bold text-xs">₹ 1,00,000</span></div><input type="range" id="loanAmount" min="10000" max="1500000" step="10000" value="100000" class="w-full h-1.5 bg-slate-200 rounded-lg cursor-pointer" oninput="calculateEMI()"><div class="flex justify-between text-[9px] text-slate-400 mt-0.5"><span>₹10K</span><span>₹15 Lakh</span></div></div>
          <div><div class="flex justify-between font-semibold mb-1"><span class="text-slate-500">Tenure:</span><span id="tenureLabel" class="text-blue-700 font-bold text-xs">24 Months</span></div><input type="range" id="loanTenure" min="3" max="60" step="1" value="24" class="w-full h-1.5 bg-slate-200 rounded-lg cursor-pointer" oninput="calculateEMI()"><div class="flex justify-between text-[9px] text-slate-400 mt-0.5"><span>3 Mos</span><span>60 Mos</span></div></div>
          <div><div class="flex justify-between font-semibold mb-1"><span class="text-slate-500">Interest Rate (% p.a.):</span><span id="rateLabel" class="text-blue-700 font-bold text-xs">14.0 %</span></div><input type="range" id="loanRate" min="9" max="36" step="0.5" value="14" class="w-full h-1.5 bg-slate-200 rounded-lg cursor-pointer" oninput="calculateEMI()"><div class="flex justify-between text-[9px] text-slate-400 mt-0.5"><span>9%</span><span>36%</span></div></div>
        </div>

