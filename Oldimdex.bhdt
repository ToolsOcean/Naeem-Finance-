    // ==================== ENGINE & TAB CONTROLLER ====================

    let currentCategory = 'zerocibil';

    function getActiveDataset() {
      if (currentCategory === 'zerocibil') return zeroCibilData;
      if (currentCategory === 'cards') return cardsData;
      if (currentCategory === 'demat') return dematInvestData;
      if (currentCategory === 'loans') return loansData;
      if (currentCategory === 'savings') return savingsData;
      if (currentCategory === 'secured') return securedCardsData;
      return zeroCibilData;
    }

    function selectCategory(type) {
      switchTab(type);
      const target = document.getElementById('offersSection');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function switchTab(type) {
      currentCategory = type;
      const tabIds = ['tabZeroCibil', 'tabCards', 'tabDemat', 'tabLoans', 'tabSavings', 'tabSecured'];
      const heading = document.getElementById('sectionHeading');

      tabIds.forEach(id => {
        const btn = document.getElementById(id);
        if (btn) btn.className = 'px-3 py-1.5 font-semibold text-xs rounded-lg text-slate-600 bg-white border border-slate-200 shrink-0 transition';
      });

      const activeTabMap = {
        'zerocibil': ['tabZeroCibil', 'Zero CIBIL & First-Time Borrower Loans'],
        'cards': ['tabCards', 'Reward & Lifetime Free Credit Cards'],
        'demat': ['tabDemat', 'Demat & Investment Portfolios'],
        'loans': ['tabLoans', 'NBFC Personal Loans & Term Credit'],
        'savings': ['tabSavings', 'Zero Balance Digital Savings Accounts'],
        'secured': ['tabSecured', 'Secured Credit Cards Against Fixed Deposit']
      };

      document.getElementById(activeTabMap[type][0]).className = 'px-3 py-1.5 font-bold text-xs rounded-lg text-white bg-blue-600 shadow-sm shrink-0 transition';
      heading.innerText = activeTabMap[type][1] + ' (' + getActiveDataset().length + ')';

      document.getElementById('globalSearch').value = '';
      renderList(getActiveDataset());
    }

    function renderList(list) {
      const grid = document.getElementById('productGrid');
      grid.innerHTML = '';

      if (list.length === 0) {
        document.getElementById('resultCount').innerText = '0 Offers';
        document.getElementById('noResults').classList.remove('hidden');
        return;
      }

      document.getElementById('resultCount').innerText = list.length + ' Offers';
      document.getElementById('noResults').classList.add('hidden');

      list.forEach(item => {
        const p = getBrandPalette(item.name);
        
        // Dynamic In-Code SVG Logo OR Image Logo
        let logoHtml = '';
        let watermarkHtml = '';

        if (item.svgType) {
          const svgCode = getSvgBadge(item.svgType);
          logoHtml = `<div class="w-full h-full p-0.5 flex items-center justify-center">${svgCode}</div>`;
          watermarkHtml = `<div class="absolute -right-6 -bottom-6 w-36 h-36 opacity-15 pointer-events-none transform rotate-12 select-none">${svgCode}</div>`;
        } else {
          logoHtml = `<img src="${item.logo}" alt="${item.name}" class="w-full h-full object-contain rounded" onerror="this.onerror=null; this.src='https://imgh.in/host/107qpx';">`;
          watermarkHtml = `<img src="${item.logo}" alt="" class="absolute -right-6 -bottom-6 w-36 h-36 object-contain opacity-15 pointer-events-none transform rotate-12 select-none" onerror="this.src='https://imgh.in/host/107qpx';">`;
        }

        const cardHtml = `
          <div class="${p.cardBg} rounded-xl p-3.5 ${p.border} shadow-sm flex flex-col justify-between app-card relative overflow-hidden">
            <!-- 15% Prominent Brand Watermark Background -->
            ${watermarkHtml}

            <div class="relative z-10">
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <div class="flex items-center gap-2.5">
                  <div class="w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center p-1 shrink-0 shadow-sm overflow-hidden">
                    ${logoHtml}
                  </div>
                  <div>
                    <h3 class="font-extrabold text-xs text-slate-900 leading-tight">${item.name}</h3>
                    <span class="text-[9px] text-slate-500 font-medium line-clamp-1">${item.sub}</span>
                  </div>
                </div>
                <span class="text-[8px] font-black px-2 py-0.5 rounded-full ${p.badgeBg} shrink-0 shadow-xs uppercase tracking-wide">
                  ${item.badge}
                </span>
              </div>

              <div class="bg-white/95 backdrop-blur-xs rounded-xl p-2.5 border border-slate-200/70 grid grid-cols-2 gap-2 text-left mb-2.5 shadow-xs">
                <div>
                  <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">${item.col1Title}</span>
                  <span class="text-[11px] font-black text-slate-900">${item.col1Val}</span>
                </div>
                <div>
                  <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">${item.col2Title}</span>
                  <span class="text-[11px] font-bold text-slate-800">${item.col2Val}</span>
                </div>
              </div>

              <!-- Accordion Toggle Button -->
              <div class="text-center mb-2">
                <button 
                  id="btn-${item.id}" 
                  onclick="toggleDetails('${item.id}')" 
                  class="text-[10px] font-extrabold ${p.accentText} hover:opacity-80 py-1 transition flex items-center justify-center gap-1 mx-auto"
                >
                  View Details & Interest Rate ▼
                </button>
              </div>

              <!-- Accordion Expandable Content -->
              <div id="details-${item.id}" class="hidden mb-3 p-3 bg-white/95 backdrop-blur-xs rounded-xl border border-slate-200 text-[10px] space-y-1.5 text-slate-600 shadow-sm">
                <div class="flex items-start gap-1"><span class="font-bold text-slate-900 shrink-0">💰 Interest / Fee:</span> <span class="font-semibold text-slate-800">${item.interest}</span></div>
                <div class="flex items-start gap-1"><span class="font-bold text-slate-900 shrink-0">🎯 Eligibility:</span> <span>${item.eligibility}</span></div>
                <div class="flex items-start gap-1"><span class="font-bold text-slate-900 shrink-0">📄 Documents:</span> <span>${item.docs}</span></div>
                <div class="flex items-start gap-1"><span class="font-bold text-slate-900 shrink-0">⏱️ Disbursal/Tenure:</span> <span>${item.disbursal}</span></div>
                <div class="flex items-start gap-1"><span class="font-bold text-slate-900 shrink-0">✨ Highlight:</span> <span class="text-emerald-700 font-extrabold">${item.highlight}</span></div>
              </div>
            </div>

            <a 
              href="${item.link}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full text-center ${p.btnBg} ${p.btnText} font-black text-[11px] py-2 rounded-xl transition active:scale-95 block shadow-sm tracking-wide relative z-10"
            >
              Apply Now →
            </a>
          </div>
        `;
        grid.insertAdjacentHTML('beforeend', cardHtml);
      });
    }

    function filterCurrentData() {
      const q = document.getElementById('globalSearch').value.toLowerCase().trim();
      const currentList = getActiveDataset();
      const filtered = currentList.filter(item => 
        item.name.toLowerCase().includes(q) || 
        item.sub.toLowerCase().includes(q) || 
        item.badge.toLowerCase().includes(q) || 
        item.col1Val.toLowerCase().includes(q) ||
        item.highlight.toLowerCase().includes(q)
      );
      renderList(filtered);
    }

    // Initialize Page
    calculateEMI();
    switchTab('zerocibil');
  </script>
</body>
</html>
